# -------------------------------------------------------------
# Restaurant POS — Environment Variables Configuration
# Copy this file to .env.local for local development.
# In Vercel, add these under Project Settings > Environment Variables.
# -------------------------------------------------------------

# Supabase Auth & Realtime Database
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Application URL (Optional - Vercel auto-detects VERCEL_URL if omitted)
# Example: https://my-restaurant-pos.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Connection (Optional if using direct Postgres via Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/restro_pos?schema=public"
